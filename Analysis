-- SQL was used for organizing and exploring data and Tableau was used for visualization
-- Two csv files were used: 2020_Olympics_Dataset and Tokyo_Olympic_Medals_Official


-- Percent of total and individual medals by country
SELECT
  RANK() OVER(ORDER BY Total DESC) AS Rank,
  Country,
  Gold,
  ROUND(Gold*100.0/SUM(Gold) OVER(),2) AS Perc_of_Gold,
  Silver,
  ROUND(Silver*100.0/SUM(Silver) OVER(),2) AS Perc_of_Silver,
  Bronze,
  ROUND(Bronze*100.0/SUM(Bronze) OVER(),2) AS Perc_of_Bronze,
  Total,
  ROUND(Total*100.0/SUM(Total) OVER(),2) AS Perc_of_Medals
FROM Tokyo_Games_v2.medals_official
ORDER BY Total DESC;



-- Percent of athletes in shared disciplines

    --GRY and SWA record null values for multiple columns as they are women only events

WITH Men AS (
  SELECT
    Discipline,
    COUNT(DISTINCT code) AS Male_Athletes
  FROM Tokyo_Games_v2.Olympic_Data
  WHERE Gender = 'Male'
  GROUP BY Discipline
),
Women AS (
  SELECT
    Discipline,
    COUNT(DISTINCT code) AS Female_Athletes
  FROM Tokyo_Games_v2.Olympic_Data
  WHERE Gender = 'Female'
  GROUP BY Discipline
)

SELECT
  COALESCE(m.Discipline, w.Discipline) AS Discipline,
  Male_Athletes + Female_Athletes AS Total_Athletes,
  Male_Athletes,
  ROUND(
    Male_Athletes * 1.0 / (Male_Athletes + Female_Athletes),
    2
  ) AS Perc_Male,
  Female_Athletes,
  ROUND(
    Female_Athletes * 1.0 / (Male_Athletes + Female_Athletes),
    2
  ) AS Perc_Female
FROM Men m
FULL JOIN Women w
  ON m.Discipline = w.Discipline
ORDER BY Discipline;


-- Count and percent of athletes by country
SELECT
  COALESCE(noc, 'All Countries') AS Country,
  COUNT(DISTINCT code) AS Count_of_Athletes,
  ROUND(
    COUNT(DISTINCT code) * 100.0 /
    SUM(
      CASE 
        WHEN GROUPING(noc) = 0 THEN COUNT(DISTINCT code)
      END
    ) OVER (),
    2
  ) AS Percent_of_Athletes
FROM Tokyo_Games_v2.Olympic_Data
GROUP BY ROLLUP(noc)
ORDER BY Count_of_Athletes DESC;



-- Average athlete age by country

SELECT
 Country,
 ROUND(AVG(AGE),2) Avg_Age
FROM (
 SELECT
   DISTINCT CODE,
   Country,
   Age
 FROM
   Tokyo_Games_v2.Olympic_Data ) AS Ages
GROUP BY
 Country
ORDER BY
 Avg_Age desc
